{
  "entities": {
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "A personal journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "topic": { "type": "string" },
        "mood": { "type": "integer" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "content", "date", "userId"]
    },
    "Expense": {
      "title": "Expense",
      "description": "A financial transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "amount", "date", "type", "userId"]
    },
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "growthPoints": { "type": "integer" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/journals/{journalId}": {
      "schema": "JournalEntry",
      "description": "User journal entries"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "User financial records"
    }
  }
}
